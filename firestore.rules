rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions & Hardening
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email == 'noviharyanto062@gmail.com';
    }

    // Verify if the user is a designated administrator for the given dinasId
    function isDinasAdminOf(dinasId) {
      return isAuthenticated() && (
        isGlobalAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          'dinasId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dinasId == dinasId
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Users can manage their own profiles; global admins can access all profiles
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin());
    }

    match /employees/{employeeId} {
      allow get, list: if true;
      allow create: if isGlobalAdmin() || (
                       'dinasId' in request.resource.data &&
                       isDinasAdminOf(request.resource.data.dinasId)
                    );
      allow update: if isGlobalAdmin() || (
                       (
                         !('dinasId' in resource.data) || 
                         isDinasAdminOf(resource.data.dinasId)
                       ) && (
                         !('dinasId' in request.resource.data) ||
                         isDinasAdminOf(request.resource.data.dinasId)
                       )
                    );
      allow delete: if isGlobalAdmin() || (
                       !('dinasId' in resource.data) ||
                       isDinasAdminOf(resource.data.dinasId)
                    );
    }

    match /attendance/{attendanceId} {
      allow get, list: if true;
      allow create: if true; // Front gate scanning is accessible
      allow update: if isGlobalAdmin() || (
                       (
                         !('dinasId' in resource.data) ||
                         isDinasAdminOf(resource.data.dinasId)
                       ) && (
                         !('dinasId' in request.resource.data) ||
                         isDinasAdminOf(request.resource.data.dinasId)
                       )
                    );
      allow delete: if isGlobalAdmin() || (
                       !('dinasId' in resource.data) ||
                       isDinasAdminOf(resource.data.dinasId)
                    );
    }

    match /settings/{dinasId} {
      allow read: if true;
      // Allow creation of configuration documents on registration/initialization
      allow create: if isAuthenticated();
      // Only Dinas admin of this settings document can modify settings
      allow update: if isGlobalAdmin() || isDinasAdminOf(dinasId);
      allow delete: if isGlobalAdmin();
    }

    match /dinases/{dinasId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isGlobalAdmin();
    }

    match /test_connection/{testId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
