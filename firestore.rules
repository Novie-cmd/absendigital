rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions & Hardening
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGlobalAdmin() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        request.auth.token.email == 'noviharyanto062@gmail.com';
    }

    // Verify if the user is a designated administrator for the given dinasId
    function isDinasAdminOf(dinasId) {
      return isAuthenticated() && (
        request.auth.token.email == 'noviharyanto062@gmail.com' || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dinasId == dinasId
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Users can manage their own profiles; global admins can access all profiles
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isGlobalAdmin());
    }

    match /employees/{employeeId} {
      allow get, list: if true;
      allow create: if isDinasAdminOf(request.resource.data.get('dinasId', 'kesbangpol'));
      allow update: if isDinasAdminOf(resource.data.get('dinasId', 'kesbangpol')) &&
                       isDinasAdminOf(request.resource.data.get('dinasId', 'kesbangpol'));
      allow delete: if isDinasAdminOf(resource.data.get('dinasId', 'kesbangpol'));
    }

    match /attendance/{attendanceId} {
      allow get, list: if true;
      allow create: if true; // Front gate scanning is accessible
      allow update: if isDinasAdminOf(resource.data.get('dinasId', 'kesbangpol')) &&
                       isDinasAdminOf(request.resource.data.get('dinasId', 'kesbangpol'));
      allow delete: if isDinasAdminOf(resource.data.get('dinasId', 'kesbangpol'));
    }

    match /settings/{dinasId} {
      allow read: if true;
      // Allow creation of configuration documents on registration/initialization
      allow create: if isAuthenticated();
      // Only Dinas admin of this settings document can modify settings
      allow update: if isDinasAdminOf(dinasId);
      allow delete: if isGlobalAdmin();
    }

    match /dinases/{dinasId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isGlobalAdmin();
    }

    match /test_connection/{testId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
